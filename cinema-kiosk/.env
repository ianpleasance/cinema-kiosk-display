# Empire Theatre kiosk settings.
# Edit, then apply with:  docker compose up -d
# Keep each setting as NAME=value on one line: no quotes, no spaces around "=",
# and comments only on their own lines (like these).

# ---- Updater --------------------------------------------------------------
# Timezone, used for the daily run time and for dropping showings already past.
TZ=Europe/London

# When the updater refreshes (24-hour, local time). Give as many times as you like,
# separated by commas or spaces, as 03:30 or 0330. Several times a day means a
# matinee or evening show disappears soon after it has started, e.g.
#   RUN_AT=0330,1230,1530,2030
RUN_AT=03:30

# Safety check: if a refresh finds MORE than this many fewer films than the last
# good one, it is assumed something went wrong (website down or changed): the old
# images stay on screen and the problem is logged. 0 turns the check off.
# (A genuine big change can be accepted with: updater.py --once --force)
MAX_ITEM_DROP=5

# The updater's log file (inside the container; docker-compose.yml puts it in
# ./logs on the Pi). It rotates itself at 2 MB, keeping 5 old files. off = console only.
LOG_FILE=/logs/updater.log

# How showing times are written on the slides and in the console:
# 12h = 7:30pm    24h = 19:30
TIME_FORMAT=12h

# The page the schedule is read from.
LISTING_URL=https://empire-theatre.co.uk/EmpireTheatre.dll/WhatsOn

# Minutes to wait before trying again after a failed update.
RETRY_MINUTES=30

# Seconds to pause between requests to the website (be polite).
REQUEST_DELAY=0.5

# Only show events in the next N days (today plus the following N days).
# 0 = show all events.
DAYS_AHEAD=0

# 1 = keep each film's original poster AND the info slide (poster + dates).
# 0 = keep only the info slide.
SAVE_POSTERS=1

# Size of the slide images the updater creates. Match your screen.
SCREEN_W=1920
SCREEN_H=1080

# ---- How the slides look (updater) ----------------------------------------
# Colours are 6-digit hex, written WITHOUT a # (a # can be read as a comment).
# Examples: FFFFFF white, 000000 black, FFD700 gold, C8102E red.

# Colour of the title, dates and the short line under the title.
TEXT_COLOUR=FFFFFF

# Colour of the text panel and of the edges around posters. The display also
# uses it for the edges around your own static images.
BACKGROUND_COLOUR=000000

# The rating circle, and the rating text inside it.
BADGE_COLOUR=C8102E
BADGE_TEXT_COLOUR=FFFFFF

# 1 = show the rating circle (U, PG, 12A, 15...), 0 = hide it.
SHOW_RATING=1

# Width of the poster area as a percentage of the screen width. The text panel
# gets the rest. 66.67 = two thirds. Allowed: 20 to 90.
POSTER_WIDTH_PERCENT=66.67

# Text sizes in pixels on a 1080-pixel-high slide. The updater uses the largest
# size that fits and shrinks towards the minimum for long titles / many dates.
TITLE_SIZE_MAX=88
TITLE_SIZE_MIN=40
DATE_SIZE_MAX=56
DATE_SIZE_MIN=30

# Font files (TrueType .ttf or OpenType .otf). Bold is used for the title and
# the rating, regular for the dates. To use your own, put the files in the
# "fonts" folder and use paths like /fonts/MyFont-Bold.ttf
FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_REG=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ---- Slideshow video (optional) ---------------------------------------------
# The updater can also make an .mp4 of the slideshow, saved in the "video" folder:
#   none  = no video
#   plain = slideshow.mp4        each slide held, no fades (quick to make)
#   fade  = slideshow-fade.mp4   with the fades set below (slower to make)
#   both  = both of the above
# It uses HOLD_SECONDS, FADE_SECONDS, FADE_MODE and STATIC_POSITION from below, and
# includes your static images. It is only remade when the slides or those settings
# change. Videos you no longer ask for are deleted. (Always in schedule order.)
VIDEO_MODE=none

# ---- Display --------------------------------------------------------------
# Seconds each slide stays on screen.
HOLD_SECONDS=10

# Seconds each fade takes.
FADE_SECONDS=1.0

# cross = crossfade between slides, black = fade out to black then fade in.
FADE_MODE=cross

# 1 = random order, 0 = in schedule order.
SHUFFLE=0

# Where your own static images (put in the "static" folder) go among the film slides:
# after = after all film slides, before = before them, spread = evenly through them.
STATIC_POSITION=after
